# Copy to .env and fill in your Monnify sandbox credentials
# Never commit .env or real keys to GitHub

PORT=3000

# sandbox | live
MONNIFY_MODE=sandbox

# From Monnify dashboard → Developers
MONNIFY_API_KEY=MK_TEST_xxxxxxxx
MONNIFY_SECRET_KEY=your_secret_key_here

# Optional overrides (defaults set from MONNIFY_MODE)
# MONNIFY_BASE_URL=https://sandbox.monnify.com
